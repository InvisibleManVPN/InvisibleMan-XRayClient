        <ControlTheme x:Key="CircleActionButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="{StaticResource AccentMint}"
                            CornerRadius="999">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentMintLight}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentMintDark}" />
            </Style>
            <Style Selector="^:disabled /template/ Border#border">
                <Setter Property="Opacity" Value="0.35" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="{StaticResource AccentMint}"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentMintLight}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentMintDark}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="RedActionButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="{StaticResource AccentRed}"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentRedLight}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource AccentRedDark}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="GrayActionButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="{StaticResource SurfaceLight}"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource SurfaceBright}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="#252526" />
            </Style>
            <Style Selector="^:disabled /template/ Border#border">
                <Setter Property="Opacity" Value="0.35" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="TabButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceLight}" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="{StaticResource SurfaceBright}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="#252526" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="Transparent"
                            Padding="6"
                            CornerRadius="999">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="#343434" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="#252526" />
            </Style>
            <Style Selector="^:disabled /template/ Border#border">
                <Setter Property="Opacity" Value="0.35" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="LinkButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="border"
                            Background="Transparent"
                            CornerRadius="8">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background" Value="#20FFFFFF" />
            </Style>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background" Value="#14FFFFFF" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceLight}"
                BoxShadow="0 2 4 0 #66000000">
            <Grid ColumnDefinitions="75,*">
                <Rectangle Grid.Column="0"
                           Width="60"
                           Height="60"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Fill="{StaticResource Icon.InvisibleGorilla}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="0">
                    <TextBlock Margin="15,7,0,0"
                               Text="INVISIBLE GORILLA"
                               VerticalAlignment="Bottom"
                                   FontWeight="Light"
                               FontSize="14"
                                   Foreground="White" />
                    <TextBlock Margin="15,-4,0,0"
                               Text="XRAY"
                               VerticalAlignment="Top"
                                   FontWeight="Light"
                               FontSize="42"
                                   Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <StackPanel x:Name="HomeSectionPanel"
                            Margin="20,16,20,28"
                            Spacing="0"
                            IsVisible="True">
                    <Grid Width="140"
                          Height="140"
                          Margin="0,6,0,0"
                          HorizontalAlignment="Center">
                        <Border x:Name="ConnectionHeroGlow"
                                Width="140"
                                Height="140"
                                CornerRadius="70"
                                Background="{StaticResource AccentMint}"
                                Opacity="0.28"
                                IsVisible="False" />

                        <Grid x:Name="StoppedHeroIcon"
                              Width="120"
                              Height="120"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Rectangle Fill="{StaticResource Icon.Stop}" />
            </Grid>

                        <Grid x:Name="RunningHeroIcon"
                              Width="120"
                              Height="120"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                              IsVisible="False">
                            <Rectangle Fill="{StaticResource Icon.Run}" />
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Border x:Name="ConnectionStateIndicator"
                                Width="12"
                                Height="12"
                                CornerRadius="6"
                                Background="#D66A75"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionStateTitleTextBlock"
                                   Text="Stopped"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="ConnectionStateSubtitleTextBlock"
                               Margin="0,8,0,0"
                               MaxWidth="320"
                               Text="Proxy mode is ready on Android."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="14" />

                    <TextBlock x:Name="CurrentConfigNameTextBlock"
                               Width="320"
                               Margin="0,22,0,0"
                               Text="No server configuration selected"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="White"
                               FontWeight="Light"
                               FontSize="18"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="CurrentConfigAppRulesSummaryTextBlock"
                               Width="320"
                               Margin="0,8,0,0"
                               Text="All apps"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               HorizontalAlignment="Center" />

                    <Button x:Name="CurrentConfigAppRulesButton"
                            Theme="{StaticResource LinkButton}"
                            MinWidth="220"
                            MinHeight="36"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Padding="12,6"
                            Click="OnOpenAppRulesEditorClick">
                        <TextBlock x:Name="CurrentConfigAppRulesButtonTextBlock"
                                   Text="App rules"
                                   TextDecorations="Underline"
                                   Foreground="{StaticResource AccentBlue}"
                                   FontSize="13" />
                    </Button>

                    <Button Theme="{StaticResource LinkButton}"
                            MinWidth="270"
                            MinHeight="40"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Padding="18,8"
                            Click="OnServersSectionClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="15"
                                  Height="15"
                                  Margin="0,0,7,0">
                                <Border Height="5"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBlue}"
                                        VerticalAlignment="Top" />
                                <Border Height="5"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBlue}"
                                        VerticalAlignment="Center" />
                                <Border Height="5"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBlue}"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock x:Name="ManageServerConfigurationTextBlock"
                                       Text="Manage server configuration"
                                       TextDecorations="Underline"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontSize="14" />
                </StackPanel>
                    </Button>

                    <Button x:Name="RunButton"
                            Width="200"
                            Height="40"
                            Margin="0,26,0,0"
                            Content="RUN"
                            Theme="{StaticResource GreenActionButton}"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="#252526"
                            HorizontalAlignment="Center"
                            Click="OnRunClick" />

                    <Button x:Name="StopButton"
                            Width="200"
                            Height="40"
                            Margin="0,26,0,0"
                            Content="STOP"
                            Theme="{StaticResource RedActionButton}"
                            FontWeight="Bold"
                            FontSize="15"
                            Foreground="#252526"
                            HorizontalAlignment="Center"
                            IsVisible="False"
                            Click="OnStopClick" />

                    <Border x:Name="HomeStatusPanel"
                            Margin="0,18,0,0"
                            Padding="16,14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}"
                            IsVisible="False">
                        <TextBlock x:Name="HomeStatusTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   FontSize="14" />
                    </Border>

                    <Border x:Name="HomeInfoPanel"
                            Margin="0,18,0,0"
                            Padding="16,14"
                            CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceLight}"
                            IsVisible="False">
                        <TextBlock x:Name="HomeInfoTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   FontSize="14" />
                    </Border>
                    </StackPanel>

                <StackPanel x:Name="ServersSectionPanel"
                            Margin="20,20,20,24"
                            Spacing="14"
                            IsVisible="False">
                    <Border Padding="16,14"
                            CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                        <Grid ColumnDefinitions="52,*">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="10"
                                    Background="#252526"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Rectangle Fill="{StaticResource Icon.Server.MintyGreen}"
                                           Width="24"
                                           Height="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock x:Name="ServersTitleTextBlock"
                                           Text="SERVER CONFIG"
                                           FontSize="21"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ServersDescriptionTextBlock"
                                           Text="Manage server configuration"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ServersStatusPanel"
                            Padding="16,14"
                            CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceLight}"
                            IsVisible="False">
                        <TextBlock x:Name="ServersStatusTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   FontSize="14" />
                    </Border>

                    <StackPanel x:Name="ServersBrowsePanel"
                                Spacing="14">
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="ConfigurationsTabButton"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    Height="38"
                                    Content="Configuration"
                                    Background="{StaticResource SurfaceBright}"
                                    Theme="{StaticResource TabButtonTheme}"
                                    Click="OnConfigurationsTabClick" />
                            <Button x:Name="SubscriptionsTabButton"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Height="38"
                                    Content="Subscription"
                                    Background="{StaticResource SurfaceLight}"
                                    Theme="{StaticResource TabButtonTheme}"
                                    Click="OnSubscriptionsTabClick" />
                        </Grid>

                        <StackPanel x:Name="ConfigurationsPanel" Spacing="14">
                <Border Padding="14"
                        CornerRadius="12"
                                    BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                                    Background="{StaticResource SurfaceLight}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="AvailableConfigurationsTextBlock"
                                               Text="Available configurations"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                                    <Grid MinHeight="280">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="GeneralConfigsListPanel"
                                                        Margin="0,0,0,58"
                                                        Spacing="6" />
                                        </ScrollViewer>

                                        <TextBlock x:Name="NoGeneralConfigsTextBlock"
                                                   Margin="0,24,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}"
                                                   IsVisible="False" />

                                        <Button x:Name="AddConfigFloatingButton"
                                                Width="56"
                                                Height="56"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Theme="{StaticResource CircleActionButton}"
                                                Click="OnAddConfigButtonClick">
                                            <Rectangle Fill="{StaticResource Icon.Plus}"
                                                       Width="18"
                                                       Height="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                    </StackPanel>
                </Border>
                        </StackPanel>

                        <StackPanel x:Name="SubscriptionsPanel"
                                    IsVisible="False"
                                    Spacing="14">
                            <Border Padding="12"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource SurfaceBright}"
                                    BorderThickness="1"
                                    Background="{StaticResource SurfaceLight}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <ComboBox x:Name="SubscriptionGroupComboBox"
                                              Grid.Column="0"
                                              Margin="0,0,8,0"
                                              SelectionChanged="OnSubscriptionSelectionChanged" />

                                    <Button x:Name="RefreshSubscriptionButton"
                                            Grid.Column="1"
                                            Width="30"
                                            Height="30"
                                            Theme="{StaticResource IconActionButton}"
                                            Click="OnRefreshSubscriptionClick">
                                        <Rectangle Fill="{StaticResource Icon.Refresh}"
                                                   Width="14"
                                                   Height="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>

                                    <Button x:Name="ShareSubscriptionButton"
                                            Grid.Column="2"
                                            Width="30"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Theme="{StaticResource IconActionButton}"
                                            Click="OnShareSubscriptionClick">
                                        <Rectangle Fill="{StaticResource Icon.Share}"
                                                   Width="11"
                                                   Height="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>

                                    <Button x:Name="DeleteSubscriptionButton"
                                            Grid.Column="3"
                                            Width="30"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Theme="{StaticResource IconActionButton}"
                                            Click="OnDeleteSubscriptionClick">
                                        <Rectangle Fill="{StaticResource Icon.Delete}"
                                                   Width="12"
                                                   Height="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                <Border Padding="14"
                        CornerRadius="12"
                                    BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                                    Background="{StaticResource SurfaceLight}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="SubscriptionGroupsTitleTextBlock"
                                               Text="Subscription groups"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                                    <Grid MinHeight="280">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="SubscriptionConfigsListPanel"
                                                        Margin="0,0,0,58"
                                                        Spacing="6" />
                                        </ScrollViewer>

                                        <TextBlock x:Name="NoSubscriptionConfigsTextBlock"
                                                   Margin="0,24,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}"
                                                   IsVisible="False" />

                                        <Button x:Name="AddSubscriptionFloatingButton"
                                                Width="56"
                                                Height="56"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Theme="{StaticResource CircleActionButton}"
                                                Click="OnAddSubscriptionButtonClick">
                                            <Rectangle Fill="{StaticResource Icon.Plus}"
                                                       Width="18"
                                                       Height="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                    </StackPanel>
                </Border>
                        </StackPanel>
            </StackPanel>

                    <StackPanel x:Name="AddConfigPanel"
                                Spacing="14"
                                IsVisible="False">
                        <Border Padding="16,14"
                                CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                                BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="AddConfigTitleTextBlock"
                                           Text="Add configuration"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="AddConfigDescriptionTextBlock"
                                           Text="Choose a file or paste a link, just like in the desktop client."
                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Border>

                <Grid ColumnDefinitions="*,*">
                            <Button x:Name="ConfigImportFileModeButton"
                            Grid.Column="0"
                            Margin="0,0,5,0"
                                    Height="38"
                                    Content="Import from file"
                                    Background="{StaticResource SurfaceLight}"
                                    Theme="{StaticResource TabButtonTheme}"
                                    Click="OnConfigFileModeClick" />
                            <Button x:Name="ConfigImportLinkModeButton"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                                    Height="38"
                                    Content="Import from link"
                                    Background="{StaticResource SurfaceBright}"
                                    Theme="{StaticResource TabButtonTheme}"
                                    Click="OnConfigLinkModeClick" />
                </Grid>

                        <Border x:Name="ConfigFileImportPanel"
                                IsVisible="False"
                                Padding="14"
                            CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ConfigFileImportTitleTextBlock"
                                           Text="Import config file"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                                <Grid ColumnDefinitions="Auto,*">
                                    <Button x:Name="ChooseConfigFileButton"
                                            Grid.Column="0"
                                            Width="126"
                                            Height="38"
                                            Content="Choose file"
                                            Theme="{StaticResource GreenActionButton}"
                                            Foreground="#252526"
                                            FontWeight="Bold"
                                            Click="OnChooseConfigFileClick" />
                                    <TextBlock x:Name="SelectedConfigFileTextBlock"
                                               Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="No file chosen..." />
                                </Grid>
                        </StackPanel>
                    </Border>

                        <Border x:Name="ConfigLinkImportPanel"
                                Padding="14"
                            CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                        <StackPanel Spacing="8">
                                <TextBlock x:Name="ImportConfigTitleTextBlock"
                                           Text="Import from link"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="ConfigLinkTextBox"
                                             Grid.Column="0"
                                             MinHeight="48"
                                     Watermark="vless://, vmess://, trojan:// or ss://" />
                                    <Button x:Name="PasteConfigLinkButton"
                                            Grid.Column="1"
                                            Width="92"
                                            Height="42"
                                            Margin="10,0,0,0"
                                            Content="PASTE"
                                            Theme="{StaticResource GrayActionButton}"
                                            FontWeight="Bold"
                                            Click="OnPasteConfigLinkClick" />
                                </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="AdvancedImportToggleButton"
                                Height="38"
                            Content="Show advanced import tools"
                                Theme="{StaticResource GrayActionButton}"
                            Click="OnToggleAdvancedImportClick" />

                    <Border x:Name="AdvancedImportPanel"
                            IsVisible="False"
                            Padding="14"
                            CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                        <StackPanel Spacing="8">
                                <TextBlock x:Name="AdvancedImportTitleTextBlock"
                                           Text="Advanced import"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                                <TextBlock x:Name="AdvancedImportDescriptionTextBlock"
                                           Text="Use raw JSON only when you need full manual control over a profile."
                                       TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />
                            <TextBox x:Name="ConfigRemarkTextBox"
                                     Watermark="Config name" />
                            <TextBox x:Name="RawConfigTextBox"
                                     Height="220"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Watermark="{}{&quot;inbounds&quot;: [], &quot;outbounds&quot;: []}" />
                                <Button x:Name="SaveRawConfigButton"
                                        Content="Save raw JSON config"
                                        Height="38"
                                        Theme="{StaticResource GreenActionButton}"
                                        Foreground="#252526"
                                        FontWeight="Bold"
                                    Click="OnSaveRawConfigClick" />
                        </StackPanel>
                    </Border>

                            <Grid ColumnDefinitions="*,*">
                            <Button x:Name="CancelConfigImportButton"
                                    Grid.Column="0"
                                        Margin="0,0,5,0"
                                    Height="38"
                                    Content="Cancel"
                                    Theme="{StaticResource RedActionButton}"
                                    Foreground="#252526"
                                    FontWeight="Bold"
                                    Click="OnCancelConfigImportClick" />
                            <Button x:Name="ConfirmConfigImportButton"
                                    Grid.Column="1"
                                        Margin="5,0,0,0"
                                    Height="38"
                                    Content="Import"
                                    Theme="{StaticResource GreenActionButton}"
                                    Foreground="#252526"
                                    FontWeight="Bold"
                                    Click="OnImportConfigClick" />
                            </Grid>
                        </StackPanel>

                    <StackPanel x:Name="AddSubscriptionPanel"
                                Spacing="14"
                                IsVisible="False">
                        <Border Padding="16,14"
                            CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="AddSubscriptionTitleTextBlock"
                                           Text="Add or replace subscription"
                                           FontSize="20"
                                       FontWeight="SemiBold" />
                                <TextBlock x:Name="AddSubscriptionDescriptionTextBlock"
                                           Text="Save a subscription by name and URL. Existing groups with the same name will be refreshed."
                                       TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="14"
                                CornerRadius="12"
                                BorderBrush="{StaticResource SurfaceBright}"
                                BorderThickness="1"
                                Background="{StaticResource SurfaceLight}">
                            <StackPanel Spacing="10">
                            <TextBox x:Name="SubscriptionRemarkTextBox"
                                     Watermark="Subscription name" />
                                <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="SubscriptionLinkTextBox"
                                             Grid.Column="0"
                                             MinHeight="48"
                                     Watermark="Subscription URL" />
                                    <Button x:Name="PasteSubscriptionLinkButton"
                                            Grid.Column="1"
                                            Width="92"
                                            Height="42"
                                            Margin="10,0,0,0"
                                            Content="PASTE"
                                            Theme="{StaticResource GrayActionButton}"
                                            FontWeight="Bold"
                                            Click="OnPasteSubscriptionLinkClick" />
                                </Grid>
                        </StackPanel>
                    </Border>

                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="CancelSubscriptionButton"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    Height="38"
                                    Content="Cancel"
                                    Theme="{StaticResource RedActionButton}"
                                    Foreground="#252526"
                                    FontWeight="Bold"
                                    Click="OnCancelSubscriptionClick" />
                            <Button x:Name="SaveSubscriptionButton"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Content="Save subscription"
                                    Height="38"
                                    Theme="{StaticResource GreenActionButton}"
                                    Foreground="#252526"
                                    FontWeight="Bold"
                                    Click="OnImportSubscriptionClick" />
                        </Grid>
                </StackPanel>
            </StackPanel>

                <StackPanel x:Name="SettingsSectionPanel"
                            Margin="20,20,20,24"
                            Spacing="14"
                            IsVisible="False">
                    <TextBlock x:Name="SettingsTitleTextBlock"
                               Text="Settings"
                           FontSize="26"
                           FontWeight="Bold" />
                    <TextBlock x:Name="SettingsDescriptionTextBlock"
                               Text="Android keeps the main screen compact. Network and diagnostics live here, while VPN/TUN remains visible as a planned capability."
                           TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}" />

                    <Border x:Name="SettingsStatusPanel"
                            Padding="16,14"
                            CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                            BorderThickness="1"
                            Background="{StaticResource SurfaceLight}"
                            IsVisible="False">
                        <TextBlock x:Name="SettingsStatusTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   FontSize="14" />
                    </Border>

                <Border Padding="14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                    <StackPanel Spacing="10">
                            <TextBlock x:Name="BasicSettingsTitleTextBlock"
                                       Text="Basic"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                            <TextBlock x:Name="ConnectionModeTitleTextBlock"
                                       Text="Connection mode" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                        Background="{StaticResource AccentMint}">
                                    <TextBlock x:Name="ProxyModeBadgeTextBlock"
                                               Text="Proxy"
                                               FontWeight="SemiBold"
                                               Foreground="#252526" />
                            </Border>
                            <Border Padding="10,4"
                                    CornerRadius="999"
                                        Background="{StaticResource SurfaceBright}">
                                    <TextBlock x:Name="VpnComingSoonBadgeTextBlock"
                                               Text="VPN/TUN coming soon"
                                               Foreground="{StaticResource TextMuted}" />
                            </Border>
                        </StackPanel>
                            <TextBlock x:Name="ProtocolTitleTextBlock"
                                       Text="Protocol" />
                        <ComboBox x:Name="ProtocolComboBox" />
                        <CheckBox x:Name="UdpEnabledCheckBox"
                                  Content="Enable UDP" />
                        <CheckBox x:Name="AnalyticsCheckBox"
                                  Content="Send anonymous analytics" />
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                    <StackPanel Spacing="10">
                            <TextBlock x:Name="NetworkTitleTextBlock"
                                       Text="Network"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                            <TextBlock x:Name="ProxyPortTitleTextBlock"
                                       Text="Proxy port" />
                        <TextBox x:Name="ProxyPortTextBox" />
                            <TextBlock x:Name="DnsTitleTextBlock"
                                       Text="DNS" />
                        <TextBox x:Name="DnsTextBox" />
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="AppRulesTitleTextBlock"
                                       Text="App Rules"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                            <TextBlock x:Name="AppRulesDescriptionTextBlock"
                                       Text="Selected apps will bypass the VPN while the rest of the device traffic continues through XRay."
                                   TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" />
                            <Border Padding="10"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource SurfaceBright}"
                                    BorderThickness="1"
                                    Background="{StaticResource SurfaceDark}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="AppRulesSummaryTextBlock"
                                               Text="All apps"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock x:Name="AppRulesConfigHintTextBlock"
                                               Text="Bound to current configuration"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" />
                                    <Button x:Name="OpenAppRulesEditorButton"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            Padding="12,0"
                                            Theme="{StaticResource GrayActionButton}"
                                            Click="OnOpenAppRulesEditorClick">
                                        <TextBlock x:Name="OpenAppRulesEditorButtonTextBlock"
                                                   Text="Manage app rules"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel IsVisible="False">
                                <CheckBox x:Name="AppRulesEnabledCheckBox" />
                                <Button x:Name="RefreshInstalledAppsButton"
                                        Click="OnRefreshInstalledAppsClick" />
                                <StackPanel x:Name="AppRulesItemsPanel" />
                                <TextBlock x:Name="NoDiscoveredAppsTextBlock" />
                            </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                    <StackPanel Spacing="8">
                            <TextBlock x:Name="TunTitleTextBlock"
                                       Text="VPN/TUN"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                            <TextBlock x:Name="TunDescriptionTextBlock"
                                       Text="The Android UI keeps VPN/TUN visible for continuity with Windows and macOS, but the actual mobile tunnel runtime is not bundled yet."
                                   TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                            Background="{StaticResource SurfaceLight}">
                    <StackPanel Spacing="10">
                            <TextBlock x:Name="LogsAndDiagnosticsTitleTextBlock"
                                       Text="Logs and diagnostics"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="LogsDescriptionTextBlock"
                                   Text="Capture, share or clear the in-app diagnostic log used for troubleshooting."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="12" />
                        <TextBlock x:Name="LogsStatusTextBlock"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" />
                        <Button x:Name="ShareLogButton"
                                Height="40"
                                Theme="{StaticResource GreenActionButton}"
                                Foreground="#252526"
                                FontWeight="SemiBold"
                                Click="OnShareLogClick">
                            <TextBlock x:Name="ShareLogButtonTextBlock"
                                       Text="Share log"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="SaveLogButton"
                                Height="40"
                                Theme="{StaticResource GrayActionButton}"
                                Click="OnSaveLogClick">
                            <TextBlock x:Name="SaveLogButtonTextBlock"
                                       Text="Save log to device"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="ClearLogButton"
                                Height="38"
                                Theme="{StaticResource RedActionButton}"
                                Click="OnClearLogClick">
                            <TextBlock x:Name="ClearLogButtonTextBlock"
                                       Text="Clear log"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <TextBlock x:Name="RuntimeTextBlock"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button x:Name="SaveSettingsButton"
                        Content="Save settings"
                            Height="40"
                            Theme="{StaticResource GreenActionButton}"
                            Foreground="#252526"
                            FontWeight="Bold"
                        Click="OnSaveSettingsClick" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="ConfigShareActionSheetBorder"
                Grid.Row="1"
                Margin="20,0,20,18"
                Padding="16,14"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{StaticResource SurfaceLight}"
                BorderBrush="{StaticResource SurfaceBright}"
                BorderThickness="1"
                CornerRadius="14"
                BoxShadow="0 4 14 0 #66000000"
                IsVisible="False">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ConfigShareTitleLabel"
                           Text="Share configuration"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Button x:Name="CopyConfigLinkSheetButton"
                        Height="40"
                        Theme="{StaticResource GrayActionButton}"
                        Click="OnCopyConfigLinkClick">
                    <TextBlock Text="Copy source link"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ExportConfigSheetButton"
                        Height="40"
                        Theme="{StaticResource GreenActionButton}"
                        Foreground="#252526"
                        Click="OnExportConfigClick">
                    <TextBlock Text="Export full configuration"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Button x:Name="CancelConfigShareSheetButton"
                        Height="38"
                        Theme="{StaticResource GrayActionButton}"
                        Click="OnCancelConfigShareClick">
                    <TextBlock Text="Cancel"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="AppRulesEditorOverlayBorder"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="#B0000000"
                IsVisible="False">
            <Grid Margin="14">
                <Border Padding="16,14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid RowDefinitions="*,50">
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="AppRulesEditorTitleTextBlock"
                                           Text="App rules"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="AppRulesEditorDescriptionTextBlock"
                                           Text="Pick a template, choose a mode, and select applications for the current configuration."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />

                                <Border Padding="10"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource SurfaceBright}"
                                        BorderThickness="1"
                                        Background="{StaticResource SurfaceDark}">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="AppRulesEditorCurrentConfigLabelTextBlock"
                                                   Text="Current configuration"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" />
                                        <TextBlock x:Name="AppRulesEditorCurrentConfigTextBlock"
                                                   Text="No server configuration selected"
                                                   TextWrapping="Wrap"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="AppRulesEditorTemplateTitleTextBlock"
                                           Text="Template"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <Grid ColumnDefinitions="*,8,110,8,110">
                                    <ComboBox x:Name="AppRulesTemplateComboBox"
                                              Grid.Column="0"
                                              SelectionChanged="OnAppRulesTemplateSelectionChanged" />
                                    <Button x:Name="NewAppRulesTemplateButton"
                                            Grid.Column="2"
                                            Height="36"
                                            Theme="{StaticResource GrayActionButton}"
                                            Click="OnNewAppRulesTemplateClick">
                                        <TextBlock Text="New"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="DeleteAppRulesTemplateButton"
                                            Grid.Column="4"
                                            Height="36"
                                            Theme="{StaticResource RedActionButton}"
                                            Click="OnDeleteAppRulesTemplateClick">
                                        <TextBlock Text="Delete"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="AppRulesEditorTemplateNameLabelTextBlock"
                                           Text="Template name"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />
                                <TextBox x:Name="AppRulesTemplateNameTextBox"
                                         TextChanged="OnAppRulesTemplateNameChanged" />

                                <TextBlock x:Name="AppRulesEditorModeTitleTextBlock"
                                           Text="Mode"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="AppRulesEditorModeDescriptionTextBlock"
                                           Text="Choose whether apps bypass the VPN, only selected apps use the VPN, or all apps are allowed."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />

                                <StackPanel Spacing="8">
                                    <RadioButton x:Name="AppRulesModeAllAppsRadioButton"
                                                 Content="All apps"
                                                 Foreground="White"
                                                 IsChecked="True"
                                                 Checked="OnAppRulesModeChanged" />
                                    <RadioButton x:Name="AppRulesModeBypassRadioButton"
                                                 Content="Bypass selected apps"
                                                 Foreground="White"
                                                 Checked="OnAppRulesModeChanged" />
                                    <RadioButton x:Name="AppRulesModeOnlySelectedRadioButton"
                                                 Content="Only selected apps use VPN"
                                                 Foreground="White"
                                                 Checked="OnAppRulesModeChanged" />
                                </StackPanel>

                                <TextBlock x:Name="AppRulesEditorSelectedCountTextBlock"
                                           Text="0 apps selected"
                                           Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"
                                           FontSize="13" />
                                <Button x:Name="OpenAppPickerButton"
                                        Height="40"
                                        HorizontalAlignment="Stretch"
                                        Theme="{StaticResource GrayActionButton}"
                                        Click="OnOpenAppPickerClick">
                                    <TextBlock x:Name="OpenAppPickerButtonTextBlock"
                                               Text="Select applications"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
        </StackPanel>
    </ScrollViewer>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,10,*">
                            <Button x:Name="CancelAppRulesEditorButton"
                                    Grid.Column="0"
                                    Height="40"
                                    Theme="{StaticResource GrayActionButton}"
                                    Click="OnCancelAppRulesEditorClick">
                                <TextBlock Text="Cancel"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="SaveAppRulesEditorButton"
                                    Grid.Column="2"
                                    Height="40"
                                    Theme="{StaticResource GreenActionButton}"
                                    Foreground="#252526"
                                    FontWeight="Bold"
                                    Click="OnSaveAppRulesEditorClick">
                                <TextBlock Text="Save app rules"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="AppPickerOverlayBorder"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="#B0000000"
                IsVisible="False">
            <Grid Margin="14">
                <Border Padding="16,14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource SurfaceLight}"
                        BorderBrush="{StaticResource SurfaceBright}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid RowDefinitions="Auto,Auto,*,50">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*"
                              Margin="0,0,0,10">
                            <Button x:Name="AppPickerBackButton"
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    Theme="{StaticResource GrayActionButton}"
                                    Click="OnAppPickerBackClick">
                                <TextBlock Text="&#8592;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18" />
                            </Button>
                            <TextBlock x:Name="AppPickerTitleTextBlock"
                                       Grid.Column="1"
                                       Text="Select applications"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,8,Auto"
                              Margin="0,0,0,10">
                            <TextBox x:Name="AppPickerSearchTextBox"
                                     Grid.Column="0"
                                     Watermark="Search apps"
                                     TextChanged="OnAppPickerSearchTextChanged" />
                            <Button x:Name="AppPickerRefreshButton"
                                    Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Theme="{StaticResource GrayActionButton}"
                                    Click="OnAppPickerRefreshClick">
                                <TextBlock Text="&#x21BB;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="AppPickerLoadingTextBlock"
                                           Text="Loading applications..."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,40,0,0"
                                           IsVisible="False" />
                                <StackPanel x:Name="AppPickerItemsPanel"
                                            Spacing="6" />
                                <TextBlock x:Name="AppPickerNoAppsTextBlock"
                                           Text="No launchable apps were found."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}"
                                           IsVisible="False" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button x:Name="AppPickerDoneButton"
                                Grid.Row="3"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Theme="{StaticResource GreenActionButton}"
                                Foreground="#252526"
                                FontWeight="Bold"
                                Click="OnAppPickerDoneClick">
                            <TextBlock x:Name="AppPickerDoneButtonTextBlock"
                                       Text="Done"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceLight}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Button x:Name="HomeSectionButton"
                        Width="30"
                        Height="30"
                        Theme="{StaticResource CircleActionButton}"
                        Click="OnHomeSectionClick">
                    <Rectangle Fill="{StaticResource Icon.About}"
                               Width="6"
                               Height="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Grid Width="30"
                      Height="30">
                    <Button Width="30"
                            Height="30"
                            Theme="{StaticResource CircleActionButton}"
                            Click="OnOpenReleasesClick">
                        <Rectangle Fill="{StaticResource Icon.Update}"
                                   Width="15"
                                   Height="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Ellipse x:Name="UpdateNotificationDot"
                             Width="10"
                             Height="10"
                             Margin="-2,-2,0,0"
                             Fill="#F0A43A"
                             Stroke="{StaticResource SurfaceLight}"
                             StrokeThickness="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             IsVisible="False" />
                </Grid>

                <Button x:Name="SettingsSectionButton"
                        Width="30"
                        Height="30"
                        Theme="{StaticResource CircleActionButton}"
                        Click="OnSettingsSectionClick">
                    <Rectangle Fill="{StaticResource Icon.Settings}"
                               Width="15"
                               Height="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Button Width="30"
                        Height="30"
                        Theme="{StaticResource CircleActionButton}"
                        Click="OnOpenBugReportingClick">
                    <Rectangle Fill="{StaticResource Icon.Bug}"
                               Width="12"
                               Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>

                <Button Width="30"
                        Height="30"
                        Theme="{StaticResource CircleActionButton}"
                        Click="OnOpenGitHubClick">
                    <Rectangle Fill="{StaticResource Icon.Github}"
                               Width="18"
                               Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
