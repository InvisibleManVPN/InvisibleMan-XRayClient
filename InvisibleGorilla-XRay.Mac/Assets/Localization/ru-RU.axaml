    <x:String x:Key="Lang.Android.Server.AddConfigTitle">Добавить конфигурацию</x:String>
    <x:String x:Key="Lang.Android.Server.AddConfigDescription">Выберите файл или вставьте ссылку, как это сделано в desktop-клиенте.</x:String>
    <x:String x:Key="Lang.Android.Server.ImportConfigButton">Импортировать конфиг по ссылке</x:String>
    <x:String x:Key="Lang.Android.Server.ShowAdvancedTools">Показать расширенный импорт</x:String>
